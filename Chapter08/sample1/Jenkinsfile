// =============================================================================
//  Chapter 08 / sample1 - Continuous Delivery pipeline (assignment solution)
//  Place this file at:  Chapter08/sample1/Jenkinsfile  in YOUR fork.
// =============================================================================

pipeline {

    // ---- REQUIREMENT: "The pipeline must run in an agent container." ----------
    // The ENTIRE pipeline runs inside this Docker container, which Jenkins spins
    // up per build. gradle:4.10.2-jdk8 gives us:
    //   * Java 8        (this old Spring/Gradle project requires JDK 8)
    //   * Gradle 4.10.2 (matches this project's wrapper)
    //   * git           (needed for the SCM checkout that runs inside the agent)
    agent {
        docker {
            image 'gradle:4.10.2-jdk8'
        }
    }

    // ---- REQUIREMENT: "The pipeline must poll github." -----------------------
    // Jenkins checks the repo every minute. A new commit on the tracked branch
    // (e.g. when your PR is merged into master) starts a build automatically.
    triggers {
        pollSCM('* * * * *')
    }

    environment {
        // Keep Gradle's cache inside the workspace so the container user can write
        // to it. Without this you can hit "cannot create directory /.gradle".
        GRADLE_USER_HOME = "${WORKSPACE}/.gradle"
    }

    stages {

        // ---- ALWAYS RUN (the tests "from last week") -------------------------
        stage('Compile') {
            steps {
                dir('Chapter08/sample1') {
                    sh 'chmod +x gradlew && ./gradlew compileJava'
                }
            }
        }

        stage('Unit test') {
            steps {
                dir('Chapter08/sample1') {
                    sh './gradlew test'
                }
            }
        }

        // ---- REQUIREMENT: run ONLY when a *.java file was modified -----------
        stage('Code coverage') {
            when {
                changeset '**/*.java'
            }
            steps {
                dir('Chapter08/sample1') {
                    sh './gradlew jacocoTestReport'
                    sh './gradlew jacocoTestCoverageVerification'
                }
            }
        }

        // ---- REQUIREMENT: run ONLY when a *.java file was modified -----------
        stage('Static code analysis') {
            when {
                changeset '**/*.java'
            }
            steps {
                dir('Chapter08/sample1') {
                    sh './gradlew checkstyleMain'
                }
            }
        }

        // ---- ALWAYS RUN -----------------------------------------------------
        // 'assemble' builds the jar WITHOUT re-running test/checkstyle, so the
        // two conditional stages above stay the single source of truth for when
        // checks run. (If your last-week solution used 'build' here, you may
        // swap it back, but then checks run every time regardless of the
        // conditional - 'assemble' keeps the behaviour clean.)
        stage('Package') {
            steps {
                dir('Chapter08/sample1') {
                    sh './gradlew assemble'
                }
            }
        }
    }

    // ---- REQUIREMENT: echo the outcome --------------------------------------
    post {
        success {
            echo 'pipeline ran perfectly'
        }
        failure {
            echo 'pipeline failure'
        }
    }
}
