// =============================================================================
//  Exercise 6 - FALLBACK Jenkinsfile (use ONLY if the Docker Cloud gives trouble)
//
//  Same branch logic as the primary file, but instead of a Docker Cloud agent it
//  uses the Docker Pipeline plugin (the same mechanism Exercise 5 used) and caches
//  Gradle data by mounting the `gradle-cache` volume directly via `args`.
//  Fewer moving parts than the Cloud, equally valid for "agents that cache gradle".
// =============================================================================

pipeline {

    agent {
        docker {
            image 'gradle:4.10.2-jdk8'
            // -u root        : write freely to the mounted volume
            // -v gradle-cache: persist Gradle's cache between runs (the caching part)
            args '-u root -v gradle-cache:/home/gradle/.gradle'
        }
    }

    environment {
        GRADLE_USER_HOME = '/home/gradle/.gradle'   // matches the volume mount above
    }

    stages {

        stage('Branch gate') {
            steps {
                script {
                    env.EFFECTIVE_BRANCH = env.CHANGE_BRANCH ?: env.BRANCH_NAME
                    echo "Effective branch = ${env.EFFECTIVE_BRANCH}"
                    boolean isMain    = (env.EFFECTIVE_BRANCH == 'main')
                    boolean isFeature = env.EFFECTIVE_BRANCH.contains('feature')
                    if (!isMain && !isFeature) {
                        error("Branch '${env.EFFECTIVE_BRANCH}' is neither 'main' nor a 'feature' branch - failing as required.")
                    }
                }
            }
        }

        stage('Compile') {
            steps { dir('Chapter08/sample1') { sh 'chmod +x gradlew && ./gradlew compileJava' } }
        }

        stage('Unit test') {
            steps { dir('Chapter08/sample1') { sh './gradlew test' } }
        }

        stage('Static code analysis') {
            steps { dir('Chapter08/sample1') { sh './gradlew checkstyleMain' } }
        }

        stage('Code coverage') {
            when { expression { (env.CHANGE_BRANCH ?: env.BRANCH_NAME) == 'main' } }
            steps {
                dir('Chapter08/sample1') {
                    sh './gradlew jacocoTestReport'
                    sh './gradlew jacocoTestCoverageVerification'
                }
            }
        }

        stage('Package') {
            steps { dir('Chapter08/sample1') { sh './gradlew assemble' } }
        }
    }

    post {
        success { echo 'pipeline ran perfectly' }
        failure { echo 'pipeline failure' }
    }
}
