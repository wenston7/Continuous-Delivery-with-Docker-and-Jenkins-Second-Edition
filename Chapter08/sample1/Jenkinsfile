// =============================================================================
//  Exercise 6 - MULTIBRANCH pipeline (Chapter 08 / sample1)
//  Place at:  Chapter08/sample1/Jenkinsfile  in YOUR fork, on every branch you test.
//
//  Branch rules (Exercise 6.1):
//    * main                       -> run ALL stages, INCLUDING Code coverage
//    * any branch with "feature"  -> run all stages EXCEPT Code coverage
//    * anything else              -> FAIL the pipeline on purpose
//
//  Caching (Exercise 6.2):
//    The agent comes from the Docker Cloud template, which mounts the named
//    volume `gradle-cache` at /home/jenkins/.gradle. GRADLE_USER_HOME points there
//    so Gradle's wrapper distribution + downloaded dependencies persist between
//    runs -> the second run is faster.
// =============================================================================

pipeline {

    // Use an agent provisioned by the Docker Cloud (label set on the template).
    agent {
        label 'gradle-agent'
    }

    environment {
        // MUST equal the agent template's mount destination, or caching does nothing.
        GRADLE_USER_HOME = '/home/jenkins/.gradle'
    }

    stages {

        // ---- Decide what this branch is allowed to do -----------------------
        stage('Branch gate') {
            steps {
                script {
                    // For a normal branch build BRANCH_NAME is the branch.
                    // For a PR build, CHANGE_BRANCH is the source branch.
                    env.EFFECTIVE_BRANCH = env.CHANGE_BRANCH ?: env.BRANCH_NAME
                    echo "Effective branch = ${env.EFFECTIVE_BRANCH}"

                    boolean isMain    = (env.EFFECTIVE_BRANCH == 'main')
                    boolean isFeature = env.EFFECTIVE_BRANCH.contains('feature')

                    if (!isMain && !isFeature) {
                        error("Branch '${env.EFFECTIVE_BRANCH}' is neither 'main' nor a 'feature' branch - failing as required by the assignment.")
                    }
                }
            }
        }

        // ---- Always run (on main and feature branches) ----------------------
        stage('Compile') {
            steps { dir('Chapter08/sample1') { sh 'chmod +x gradlew && ./gradlew compileJava' } }
        }

        stage('Unit test') {
            steps { dir('Chapter08/sample1') { sh './gradlew test' } }
        }

        stage('Static code analysis') {
            steps { dir('Chapter08/sample1') { sh './gradlew checkstyleMain' } }
        }

        // ---- Code coverage: ONLY on main ------------------------------------
        stage('Code coverage') {
            when {
                expression { (env.CHANGE_BRANCH ?: env.BRANCH_NAME) == 'main' }
            }
            steps {
                dir('Chapter08/sample1') {
                    sh './gradlew jacocoTestReport'
                    sh './gradlew jacocoTestCoverageVerification'
                }
            }
        }

        // ---- Always run -----------------------------------------------------
        // 'assemble' builds the jar without re-running test/checkstyle, so the
        // conditional stages above stay the single source of truth.
        stage('Package') {
            steps { dir('Chapter08/sample1') { sh './gradlew assemble' } }
        }
    }

    post {
        success { echo 'pipeline ran perfectly' }
        failure { echo 'pipeline failure' }
    }
}
